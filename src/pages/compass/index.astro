---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Compass from '../../components/motifs/Compass.astro';
import Needle from '../../components/compass/Needle.astro';
import HouseResult from '../../components/compass/HouseResult.astro';
import { houseOrder } from '../../data/banners';
import { houseAngle } from '../../data/compass';

const quiz = (await getEntry('compass', 'questions'))!.data;
const houses = (await getCollection('houses')).sort((a, b) => houseOrder.indexOf(a.data.name) - houseOrder.indexOf(b.data.name));
// Rotate the answer order per question so no house always sits first.
const questions = quiz.questions.map((q, i) => ({ ...q, answers: q.answers.map((_, j) => q.answers[(j + i) % 4]) }));
---
<Base title="The Compass" description="Touch the compass. Nine questions, and it will point to your house: Polaris, Aurora, Lyra or Orion.">
  <PageHero eyebrow="The Compass" title="What's your house?" lede={quiz.intro} />

  <section class="night relative px-4 pb-24 sm:px-8" data-quiz data-no-reveal>
    <div class="mx-auto grid max-w-6xl items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:gap-16">
      <div class="relative mx-auto" style="width:min(72vw, 440px)">
        <Compass size="100%" />
        <Needle id="needle" angle={0} />
      </div>

      <div class="lg:min-h-[30rem]">
        <noscript>
          <p class="text-lg text-starlight/80">The Compass needs JavaScript to turn. You can still <a class="underline decoration-gold underline-offset-4" href="/houses">meet the four houses</a>.</p>
        </noscript>

        <div data-questions hidden>
          <div class="flex items-center justify-between gap-4">
            <p class="eyebrow text-gold-light" aria-live="polite" data-progress>Question 1 of {questions.length}</p>
            <button type="button" class="eyebrow min-h-11 px-2 text-starlight/70 underline-offset-4 hover:underline disabled:invisible" data-back disabled>Back</button>
          </div>
          <div class="mt-2 h-px w-full bg-starlight/15"><div class="h-px bg-gold transition-[width] duration-500" style="width:0%" data-bar></div></div>

          {questions.map((q, i) => (
            <fieldset class="mt-8" data-q={i} hidden={i !== 0}>
              <legend class="font-display text-[clamp(1.9rem,5vw,2.8rem)] leading-tight outline-none" tabindex="-1">{q.q}</legend>
              <ul class="mt-8 grid gap-3">
                {q.answers.map((a) => (
                  <li>
                    <button type="button" data-house={a.house} aria-pressed="false"
                      class="glass glass-lift w-full !rounded-2xl px-5 py-4 text-left text-lg text-starlight/90 hover:border-gold/60 aria-pressed:border-gold aria-pressed:bg-gold/15">{a.text}</button>
                  </li>
                ))}
              </ul>
            </fieldset>
          ))}
        </div>

        <p data-turning hidden class="eyebrow text-center text-gold-light lg:text-left" role="status">The compass is turning…</p>

        {houses.map(({ data: h }) => (
          <div data-result={h.name} hidden>
            <HouseResult house={h} headingLevel="h2">
              <a href={`/houses/${h.name.toLowerCase()}`} class="btn btn-gold">Meet {h.name}</a>
              <button type="button" class="btn btn-ghost" data-share={h.name}>Share your house</button>
              <button type="button" class="btn btn-ghost" data-retake>Ask again</button>
            </HouseResult>
            <p class="mt-4 min-h-6 text-center text-sm text-starlight/70 lg:text-left" aria-live="polite" data-share-status></p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>

<script define:vars={{ angles: houseAngle, total: questions.length }}>
  const root = document.querySelector('[data-quiz]');
  const qs = [...root.querySelectorAll('[data-q]')];
  const wrap = root.querySelector('[data-questions]');
  const needle = document.getElementById('needle');
  const progress = root.querySelector('[data-progress]');
  const bar = root.querySelector('[data-bar]');
  const back = root.querySelector('[data-back]');
  const turning = root.querySelector('[data-turning]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let picks = [];
  let spin = 0;

  const point = (deg, turns = 0) => {
    // Always turn clockwise to the new bearing, adding whole turns for the reveal.
    const cur = ((spin % 360) + 360) % 360;
    spin += ((deg - cur + 360) % 360) + turns * 360;
    needle.style.transform = `rotate(${spin}deg)`;
  };
  const leader = (list) => {
    const score = {};
    list.forEach((h, i) => { score[h] = (score[h] || 0) + 1 + i / 1000; }); // a tie goes to the latest answer
    return Object.entries(score).sort((a, b) => b[1] - a[1])[0]?.[0];
  };
  const show = (i, focus = true) => {
    qs.forEach((q, j) => { q.hidden = j !== i; });
    progress.textContent = `Question ${i + 1} of ${total}`;
    bar.style.width = `${(i / total) * 100}%`;
    back.disabled = i === 0;
    qs[i].querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(picks[i] === b.dataset.house)));
    if (focus) qs[i].querySelector('legend').focus();
  };
  const reveal = () => {
    const house = leader(picks);
    wrap.hidden = true;
    turning.hidden = false;
    // On phones the compass sits above the questions: bring it into view for the spin.
    needle.parentElement.scrollIntoView({ block: 'center', behavior: reduce ? 'auto' : 'smooth' });
    point(angles[house], reduce ? 0 : 3);
    setTimeout(() => {
      turning.hidden = true;
      const card = root.querySelector(`[data-result="${house}"]`);
      card.hidden = false;
      card.querySelector('[data-result-heading]').focus();
    }, reduce ? 0 : 3000);
  };
  const start = () => {
    picks = [];
    root.querySelectorAll('[data-result]').forEach((r) => { r.hidden = true; });
    wrap.hidden = false;
    show(0, false);
  };

  qs.forEach((q, i) => q.addEventListener('click', (e) => {
    const btn = e.target.closest('button[data-house]');
    if (!btn) return;
    picks[i] = btn.dataset.house;
    picks.length = i + 1;
    point(angles[leader(picks)]);
    if (i + 1 < total) show(i + 1); else reveal();
  }));
  back.addEventListener('click', () => {
    const i = qs.findIndex((q) => !q.hidden);
    if (i > 0) show(i - 1);
  });
  root.querySelectorAll('[data-retake]').forEach((b) => b.addEventListener('click', () => {
    start();
    point(0);
    qs[0].querySelector('legend').focus();
  }));
  root.querySelectorAll('[data-share]').forEach((b) => b.addEventListener('click', async () => {
    const house = b.dataset.share;
    const url = new URL(`/compass/${house.toLowerCase()}/`, location.origin).href;
    const status = b.closest('[data-result]').querySelector('[data-share-status]');
    const text = `The compass points to ${house}. What's your house?`;
    try {
      if (navigator.share) { await navigator.share({ title: 'The Compass · Unitaria', text, url }); return; }
      await navigator.clipboard.writeText(`${text} ${url}`);
      status.textContent = 'Link copied.';
    } catch (err) {
      if (err?.name !== 'AbortError') status.textContent = `Copy this link: ${url}`;
    }
  }));
  start();
</script>
