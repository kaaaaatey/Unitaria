---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import FourPointStar from '../../components/motifs/FourPointStar.astro';
import { banners, houseOrder } from '../../data/banners';

export async function getStaticPaths() {
  const houses = await getCollection('houses');
  return houses.map((entry) => ({ params: { slug: entry.data.name.toLowerCase() }, props: { entry } }));
}
const h = Astro.props.entry.data;
const i = houseOrder.indexOf(h.name);
const next = houseOrder[(i + 1) % 4];

const groups = [
  { title: 'Symbols', rows: [
    ['Crest', h.crest], ['Creature', h.creature], ['Mascot', `${h.mascot.name}. ${h.mascot.description ?? ''}`],
    ['Colours', h.colours.join(' and ')], ['Flower', h.flower], ['Gemstone', h.gemstone], ['Pin', h.pin],
  ] },
  { title: 'Character', rows: [
    ['At their best', h.best], ['At their worst', h.worst], ['What other houses say', h.stereotype],
  ] },
  { title: 'People', rows: [
    ['Founder', h.founder], ['Head of house', h.head], ['Alumni', h.alumni],
    ...(h.campusAnimals ? [['Campus animals', h.campusAnimals]] : []), ...(h.relic ? [['House relic', h.relic]] : []),
  ] },
  { title: 'Places', rows: [
    ['Wing', h.wing], ['Common room', h.commonRoom], ['Signature space', h.signatureSpace], ['In the Great Hall', h.hall],
  ] },
  { title: 'Competition', rows: [
    ['Points from', h.pointsFrom], [h.event.name, h.event.text], ['Rivals', h.rivals], ['Cause', h.cause],
  ] },
];
---
<Base title={h.name} description={`${h.name}, House of the ${h.direction}. ${h.rule}: "${h.creed}"`}>
  <div style={`--h-bg:${h.theme.bg};--h-fg:${h.theme.fg};--h-accent:${h.theme.accent}`}>
    <section class="relative overflow-hidden px-4 pb-20 pt-16 sm:px-8 sm:pt-24 lg:pt-36" style="background:var(--h-bg);color:var(--h-fg)">
      <div class="mx-auto grid max-w-6xl items-center gap-12 md:grid-cols-[1fr_minmax(0,340px)]">
        <div class="text-center md:text-left">
          <p class="eyebrow" style="color:var(--h-accent)">House of the {h.direction} · {h.bearing}</p>
          <h1 class="display mt-5 text-[clamp(3rem,12vw,7rem)] leading-none tracking-[0.18em]">{h.name}</h1>
          <p class="eyebrow mt-8" style="color:var(--h-accent)">{h.rule}</p>
          <p class="mt-3 font-display text-[clamp(1.6rem,4vw,2.4rem)] italic">“{h.creed}”</p>
          <p class="mt-6"><span class="font-display text-2xl italic">{h.motto}</span><span class="opacity-75">, “{h.mottoTranslation}”</span></p>
          <dl class="mx-auto mt-10 grid max-w-md grid-cols-3 gap-4 text-center md:mx-0 md:text-left">
            <div><dt class="eyebrow text-[0.6rem] opacity-70">Element</dt><dd class="mt-1 font-display text-2xl">{h.element}</dd></div>
            <div><dt class="eyebrow text-[0.6rem] opacity-70">Season</dt><dd class="mt-1 font-display text-2xl">{h.season}</dd></div>
            <div><dt class="eyebrow text-[0.6rem] opacity-70">Members</dt><dd class="mt-1 font-display text-2xl">{h.nickname}</dd></div>
          </dl>
        </div>
        <Image src={banners[h.name]} widths={[340, 447]} sizes="340px" loading="eager"
          alt={`The ${h.name} banner: ${h.crest}`}
          data-tilt class="mx-auto aspect-[447/1197] w-[min(70vw,340px)] rounded-xl shadow-2xl shadow-black/40" />
      </div>
    </section>

    <section class="marble px-4 py-20 text-center sm:px-8">
      <p class="eyebrow text-gold-deep">The chant</p>
      <blockquote class="mx-auto mt-6 max-w-3xl font-display text-[clamp(1.7rem,4.5vw,2.8rem)] italic leading-snug">
        {h.chant.split(' / ').map((line) => <span class="block">{line}</span>)}
      </blockquote>
      <p class="mx-auto mt-10 max-w-xl"><span class="eyebrow text-gold-deep">The oath</span><br /><span class="font-display text-xl italic">“{h.oath}”</span></p>
    </section>

    <section class="bg-marble-deep px-4 py-20 sm:px-8">
      <div class="mx-auto max-w-5xl">
        <h2 class="eyebrow text-center text-gold-deep">Rituals</h2>
        <ul class="mt-8 grid gap-6 md:grid-cols-3">
          {[['Welcome', h.welcome], ['Celebration', h.celebration], ['Secret tradition', { name: 'Only members know', text: h.secret }]].map(([label, r]: any) => (
            <li class="glass-light p-7">
              <p class="eyebrow text-[0.62rem] text-gold-deep">{label}</p>
              <h3 class="mt-2 text-2xl">{r.name}</h3>
              <p class="mt-2">{r.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="marble px-4 py-20 sm:px-8">
      <div class="mx-auto grid max-w-5xl gap-14 md:grid-cols-2">
        {groups.map((g) => (
          <div>
            <h2 class="flex items-center gap-3 text-3xl"><FourPointStar size={14} class="text-gold-deep" />{g.title}</h2>
            <dl class="mt-6 divide-y divide-vein border-y border-vein">
              {g.rows.map(([k, v]) => (
                <div class="grid gap-1 py-3 sm:grid-cols-[9rem_1fr] sm:gap-4">
                  <dt class="eyebrow pt-1 text-[0.62rem] text-gold-deep">{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))}
            </dl>
          </div>
        ))}
      </div>
    </section>

    <section class="px-4 py-20 text-center sm:px-8" style="background:var(--h-bg);color:var(--h-fg)">
      <p class="eyebrow" style="color:var(--h-accent)">You know you're one of the {h.nickname} when…</p>
      <p class="mx-auto mt-6 max-w-2xl font-display text-[clamp(1.5rem,4vw,2.2rem)] italic">{h.youKnow}</p>
      <p class="mx-auto mt-8 max-w-xl text-sm opacity-75">House merch: {h.merch}</p>
      <div class="mt-12 flex flex-wrap justify-center gap-4">
        <a href="/houses" class="btn btn-ghost">All four houses</a>
        <a href={`/houses/${next.toLowerCase()}`} class="btn btn-gold">Next: {next}</a>
      </div>
    </section>
  </div>
</Base>
