---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Timeline from '../components/Timeline.astro';
import FourPointStar from '../components/motifs/FourPointStar.astro';
import SectionHead from '../components/life/SectionHead.astro';

const page = (await getEntry('pages', 'life'))!;
const d = page.data;
const s = Object.fromEntries((d.sections ?? []).map((x) => [x.id, x]));
const ages = [
  { age: 'Under 16', personal: '10% allowance for treats', family: '40%, which your family may share back', trust: '50% to the Academy, for your Academy year, graduation and gown' },
  { age: '16 to 20', personal: '50%, yours to keep', family: 'Nothing owed', trust: '50%, unlocked at 21' },
  { age: '21 and over', personal: '100%, full autonomy', family: 'Optional', trust: 'Your starter trust unlocks' },
];
const year = (s.days.items ?? []).map((it) => ({ when: it.tag ?? '', title: it.title, text: it.text }));
const pad = 'px-4 py-20 sm:px-8 sm:py-24';
---
<Base title={d.title} description={d.description}>
  <PageHero eyebrow={d.eyebrow} title="A life well rewarded" lede={d.lede} />

  <!-- Basic rights -->
  <section class={`marble ${pad}`}>
    <div class="mx-auto max-w-6xl">
      <SectionHead eyebrow={s.rights.eyebrow} heading={s.rights.heading} text={s.rights.text} />
      <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {s.rights.items?.map((it) => (
          <li class="border-t border-gold/60 pt-5">
            <h3 class="flex items-center gap-3 text-2xl"><FourPointStar size={12} class="text-gold-deep" />{it.title}</h3>
            <p class="mt-2 text-ink/80">{it.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Housing -->
  <section id="home" class={`bg-marble-deep ${pad}`}>
    <div class="mx-auto max-w-6xl">
      <SectionHead eyebrow={s.home.eyebrow} heading={s.home.heading} text={s.home.text} />
      <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {s.home.items?.map((it) => (
          <li class="glass-light p-7">
            <p class="eyebrow text-gold-deep">{it.tag}</p>
            <h3 class="mt-3 text-2xl">{it.title}</h3>
            <p class="mt-2 text-ink/80">{it.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Careers -->
  <section id="careers" class={`marble ${pad}`}>
    <div class="mx-auto max-w-5xl">
      <SectionHead eyebrow={s.careers.eyebrow} heading={s.careers.heading} text={s.careers.text} />
      <ul class="mt-12 grid gap-6 sm:grid-cols-2">
        {s.careers.items?.map((it) => (
          <li class="border-t border-gold/60 pt-5">
            <h3 class="flex items-center gap-3 text-2xl"><FourPointStar size={12} class="text-gold-deep" />{it.title}</h3>
            <p class="mt-2 text-ink/80">{it.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Healthcare and the commissary -->
  <section id="care" class={`night ${pad}`}>
    <div class="mx-auto max-w-5xl">
      <SectionHead eyebrow={s.care.eyebrow} heading={s.care.heading} dark />
      <ul class="mt-12 grid gap-6 md:grid-cols-2">
        {s.care.items?.map((it) => (
          <li class="glass p-8">
            <p class="eyebrow text-gold-light">{it.tag}</p>
            <h3 class="mt-3 text-3xl">{it.title}</h3>
            <p class="mt-3 text-starlight/80">{it.text}</p>
          </li>
        ))}
      </ul>
      <p class="mt-10 text-center"><a href="/realms/andongo" class="btn btn-ghost">Visit Andongo</a></p>
    </div>
  </section>

  <!-- Points -->
  <section id="points" class={`bg-marble-deep ${pad}`}>
    <div class="mx-auto max-w-6xl">
      <SectionHead eyebrow={s.points.eyebrow} heading={s.points.heading} text={s.points.text} />
      <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {s.points.items?.map((it) => (
          <li class="border-t border-gold/60 pt-5">
            <h3 class="flex items-center gap-3 text-2xl"><FourPointStar size={12} class="text-gold-deep" />{it.title}</h3>
            <p class="mt-2 text-ink/80">{it.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Points by age, the family's 40%, and the 21st birthday -->
  <section class={`marble ${pad}`}>
    <div class="mx-auto max-w-5xl">
      <SectionHead eyebrow="Points by age" heading="Where every point goes" size="md" />
      <div class="mt-10 overflow-x-auto">
        <table class="w-full min-w-[560px] text-left">
          <caption class="sr-only">How points are shared at each age</caption>
          <thead>
            <tr class="border-b border-gold/60 font-display text-xl">
              <th scope="col" class="py-3 pr-4 font-normal">Age</th><th scope="col" class="py-3 pr-4 font-normal">You</th>
              <th scope="col" class="py-3 pr-4 font-normal">Your family</th><th scope="col" class="py-3 font-normal">Trust</th>
            </tr>
          </thead>
          <tbody>
            {ages.map((a) => (
              <tr class="border-b border-vein align-top">
                <th scope="row" class="py-4 pr-4 font-display text-xl font-normal">{a.age}</th>
                <td class="py-4 pr-4">{a.personal}</td><td class="py-4 pr-4">{a.family}</td><td class="py-4">{a.trust}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-6 text-center text-ink/70">Every point a child earns also counts towards their leaderboard total, revealed when they turn sixteen.</p>

      <div class="mt-20">
        <SectionHead eyebrow={s.family.eyebrow} heading={s.family.heading} text={s.family.text} size="md" />
        <ul class="mt-10 grid gap-6 sm:grid-cols-3">
          {s.family.items?.map((it) => (
            <li class="glass-light p-7 text-center">
              <h3 class="text-2xl">{it.title}</h3>
              <p class="mt-2 text-ink/80">{it.text}</p>
            </li>
          ))}
        </ul>
      </div>

      <div class="glass-light mx-auto mt-16 max-w-3xl px-6 py-10 text-center sm:px-12">
        <FourPointStar size={18} class="mx-auto text-gold-deep" />
        <p class="eyebrow mt-4 text-gold-deep">{s.trust.eyebrow}</p>
        <h3 class="mt-3 text-[clamp(1.8rem,4vw,2.6rem)] text-balance">{s.trust.heading}</h3>
        <p class="mt-4 text-lg text-ink/80">{s.trust.text}</p>
      </div>
    </div>
  </section>

  <!-- The task board -->
  <section id="task-board" class={`night ${pad}`}>
    <div class="mx-auto max-w-6xl">
      <SectionHead eyebrow={s.boards.eyebrow} heading={s.boards.heading} text={s.boards.text} dark />
      <ol class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-5">
        {s.boards.items?.map((it) => (
          <li class="glass p-7">
            <span class="font-display text-4xl text-gold-light" aria-hidden="true">{it.tag}</span>
            <h3 class="mt-3 text-2xl">{it.title}</h3>
            <p class="mt-2 text-starlight/75">{it.text}</p>
          </li>
        ))}
      </ol>

      <div class="hairline mx-auto mt-16 max-w-3xl" aria-hidden="true"></div>
      <div class="mt-14">
        <SectionHead eyebrow={s['board-rules'].eyebrow} heading={s['board-rules'].heading} dark size="md" />
        <ul class="mt-10 grid gap-6 md:grid-cols-3">
          {s['board-rules'].items?.map((it) => (
            <li class="border-t border-gold/50 pt-5">
              <h3 class="flex items-center gap-3 text-2xl"><FourPointStar size={12} class="text-gold-light" />{it.title}</h3>
              <p class="mt-2 text-starlight/75">{it.text}</p>
            </li>
          ))}
        </ul>
      </div>
      <p class="mt-12 text-center"><a href="/realms/neuropa" class="btn btn-ghost">See a real task board in Neuropa</a></p>
    </div>
  </section>

  <!-- Everyday tasks and baking -->
  <section id="everyday" class={`marble ${pad}`}>
    <div class="mx-auto max-w-5xl">
      <SectionHead eyebrow={s.everyday.eyebrow} heading={s.everyday.heading} text={s.everyday.text} />
      <ul class="mt-10 flex flex-wrap justify-center gap-3">
        {s.everyday.items?.map((it) => (
          <li class="glass-light !rounded-full px-5 py-2.5 text-ink/90">
            {it.title}{it.tag && <span class="eyebrow ml-2 text-gold-deep">{it.tag}</span>}
          </li>
        ))}
      </ul>

      <div class="glass-light mx-auto mt-16 max-w-3xl px-6 py-10 text-center sm:px-12">
        <p class="eyebrow text-gold-deep">{s.baking.eyebrow}</p>
        <h3 class="mt-3 text-[clamp(1.8rem,4vw,2.6rem)]">{s.baking.heading}</h3>
        <p class="mt-4 text-lg text-ink/80">{s.baking.text}</p>
      </div>
    </div>
  </section>

  <!-- Pledges -->
  <section id="pledges" class={`bg-marble-deep ${pad}`}>
    <div class="mx-auto max-w-5xl">
      <SectionHead eyebrow={s.pledges.eyebrow} heading={s.pledges.heading} text={s.pledges.text} />
      <ul class="mt-12 grid gap-6 md:grid-cols-3">
        {s.pledges.items?.map((it) => (
          <li class="glass-light p-7">
            <h3 class="flex items-center gap-3 text-2xl"><FourPointStar size={12} class="text-gold-deep" />{it.title}</h3>
            <p class="mt-2 text-ink/80">{it.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- The community pot -->
  <section id="community-pot" class={`night ${pad}`}>
    <div class="mx-auto max-w-4xl">
      <SectionHead eyebrow={s.pot.eyebrow} heading={s.pot.heading} text={s.pot.text} dark size="md" />
    </div>
  </section>

  <!-- The days we celebrate: the year at a glance -->
  <section id="days" class={`marble ${pad}`}>
    <div class="mx-auto max-w-5xl">
      <SectionHead eyebrow={s.days.eyebrow} heading={s.days.heading} text={s.days.text} />
      <div class="mt-14"><Timeline items={year} /></div>
    </div>
  </section>

  <!-- Reconnection Day -->
  <section id="reconnection-day" class={`bg-marble-deep ${pad}`}>
    <div class="mx-auto max-w-5xl">
      <SectionHead eyebrow={s.reconnection.eyebrow} heading={s.reconnection.heading} text={s.reconnection.text} />
      <ul class="mt-12 grid gap-6 md:grid-cols-3">
        {s.reconnection.items?.map((it) => (
          <li class="glass-light p-7">
            <h3 class="text-2xl">{it.title}</h3>
            <p class="mt-2 text-ink/80">{it.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Day of the Dead in Cariberia -->
  <section id="day-of-the-dead" class={`night ${pad}`}>
    <div class="mx-auto max-w-4xl">
      <SectionHead eyebrow={s.dead.eyebrow} heading={s.dead.heading} text={s.dead.text} dark />
      <p class="mt-10 text-center"><a href="/realms/cariberia" class="btn btn-ghost">Visit Cariberia</a></p>
    </div>
  </section>

  <!-- Thanksmas -->
  <section id="thanksmas" class={`marble ${pad}`}>
    <div class="mx-auto max-w-6xl">
      <SectionHead eyebrow={s.thanksmas.eyebrow} heading={s.thanksmas.heading} text={s.thanksmas.text} />
      <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {s.thanksmas.items?.map((it, i) => (
          <li class={`glass-light p-7 ${i === 4 ? 'sm:col-span-2 lg:col-span-2' : ''}`}>
            <h3 class="flex items-center gap-3 text-2xl"><FourPointStar size={12} class="text-gold-deep" />{it.title}</h3>
            <p class="mt-2 text-ink/80">{it.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Birthdays -->
  <section id="birthdays" class={`bg-marble-deep ${pad}`}>
    <div class="mx-auto max-w-4xl">
      <SectionHead eyebrow={s.birthday.eyebrow} heading={s.birthday.heading} text={s.birthday.text} />
    </div>
  </section>
</Base>
