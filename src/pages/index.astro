---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Compass from '../components/motifs/Compass.astro';
import FourPointStar from '../components/motifs/FourPointStar.astro';
import StarRule from '../components/motifs/StarRule.astro';
import Starfield from '../components/motifs/Starfield.astro';
import Cta from '../components/Cta.astro';
import academyHero from '../../assets/crops/academy-hero.jpg';
import bPolaris from '../../assets/crops/banner-polaris.jpg';
import bAurora from '../../assets/crops/banner-aurora.jpg';
import bLyra from '../../assets/crops/banner-lyra.jpg';
import bOrion from '../../assets/crops/banner-orion.jpg';

const sections = (await getCollection('home')).sort((a, b) => a.data.order - b.data.order);
const byId = Object.fromEntries(
  await Promise.all(sections.map(async (s) => [s.id.replace(/^\d+-/, ''), { ...s.data, Content: (await render(s)).Content }])),
);
const { jubilee, reconnected, noise, season, seven, houses } = byId;

const houseOrder = ['Polaris', 'Aurora', 'Lyra', 'Orion'];
const banners = { Polaris: bPolaris, Aurora: bAurora, Lyra: bLyra, Orion: bOrion };
const houseList = (await getCollection('houses')).sort((a, b) => houseOrder.indexOf(a.data.name) - houseOrder.indexOf(b.data.name));
---
<Base title="Unitaria" description="The Golden Jubilee: the 50th Reconnection Day, 7 May 2077.">
  <!-- Hero: the Golden Jubilee -->
  <section class="night relative isolate flex min-h-dvh items-center overflow-hidden px-4 pb-20 pt-28 sm:px-8">
    <div class="absolute inset-0 -z-10" data-parallax="0.25">
      <Image src={academyHero} alt="" widths={[800, 1312]} sizes="100vw" loading="eager"
        class="h-[120%] w-full object-cover object-top opacity-40" />
      <div class="absolute inset-0 bg-gradient-to-b from-midnight/40 via-midnight/70 to-midnight"></div>
    </div>
    <Starfield />
    <div class="mx-auto flex max-w-4xl flex-col items-center text-center">
      <p class="eyebrow text-gold-light">{jubilee.eyebrow}</p>
      <Compass size="min(62vw, 300px)" class="mt-8" />
      <h1 class="display mt-8 text-[clamp(2.6rem,9vw,6.5rem)] leading-[0.95] tracking-[0.12em] text-starlight">
        {jubilee.heading}
      </h1>
      <p class="eyebrow mt-6 text-gold-light">
        {jubilee.subheading?.split(' · ').map((part, i) => (
          <span class="block whitespace-nowrap sm:inline">{i > 0 && <span class="hidden sm:inline"> · </span>}{part}</span>
        ))}
      </p>
      <div class="prose-world mx-auto mt-8 text-lg text-starlight/80 [&_p]:mx-auto"><jubilee.Content /></div>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href="#reconnected" class="btn btn-gold">Enter the Jubilee</a>
        {jubilee.cta && <Cta {...jubilee.cta} />}
      </div>
    </div>
  </section>

  <!-- Fifty years reconnected -->
  <section id="reconnected" class="marble scroll-mt-16 px-4 py-24 sm:px-8 sm:py-32">
    <div class="mx-auto grid max-w-6xl gap-14 lg:grid-cols-[1.2fr_1fr] lg:items-center">
      <div>
        <p class="eyebrow text-gold-deep">{reconnected.eyebrow}</p>
        <h2 class="mt-4 text-[clamp(2.2rem,6vw,4rem)]">{reconnected.heading}</h2>
        <StarRule class="mt-8 max-w-56" />
        <div class="prose-world mt-8 text-lg"><reconnected.Content /></div>
        {reconnected.cta && <div class="mt-10"><Cta {...reconnected.cta} /></div>}
      </div>
      <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-sm border border-gold/40 bg-gold/40">
        {reconnected.stats?.map((s) => (
          <div class="flex flex-col items-center justify-center bg-marble px-4 py-10 text-center">
            <dd class="font-display text-[clamp(3rem,10vw,5rem)] leading-none text-gold-deep">{s.value}</dd>
            <dt class="eyebrow order-last mt-3 text-ink/70">{s.label}</dt>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Five minutes of noise -->
  <section class="night relative isolate overflow-hidden px-4 py-28 text-center sm:px-8 sm:py-36">
    <div class="absolute inset-0 -z-10 grid place-items-center" aria-hidden="true">
      {[0, 1, 2, 3].map((i) => (
        <span class="noise-ring absolute aspect-square w-[min(90vw,640px)] rounded-full border border-gold/40" style={`animation-delay:${i * 1.5}s`}></span>
      ))}
    </div>
    <p class="eyebrow text-gold-light">{noise.eyebrow}</p>
    <h2 class="display mt-5 text-[clamp(2.2rem,7vw,4.5rem)] tracking-[0.1em]">{noise.heading}</h2>
    <div class="prose-world mx-auto mt-10 max-w-2xl text-lg text-starlight/80 [&_p]:mx-auto [&_p:first-child]:font-display [&_p:first-child]:text-3xl [&_p:first-child]:italic [&_p:first-child]:text-gold-light">
      <noise.Content />
    </div>
  </section>

  <!-- The Exhibition season -->
  <section class="marble px-4 py-24 sm:px-8 sm:py-32">
    <div class="mx-auto max-w-5xl">
      <div class="text-center">
        <p class="eyebrow text-gold-deep">{season.eyebrow}</p>
        <h2 class="mt-4 text-[clamp(2.2rem,6vw,4rem)]">{season.heading}</h2>
        <div class="prose-world mx-auto mt-6 text-lg [&_p]:mx-auto"><season.Content /></div>
      </div>
      <ol class="relative mx-auto mt-16 max-w-3xl">
        <span class="absolute bottom-3 left-[11px] top-3 w-px bg-gradient-to-b from-gold/0 via-gold to-gold/0 sm:left-1/2" aria-hidden="true"></span>
        {season.timeline?.map((t, i) => (
          <li class={`relative pb-12 pl-12 last:pb-0 sm:w-1/2 sm:pl-0 ${i % 2 ? 'sm:ml-auto sm:pl-12' : 'sm:pr-12 sm:text-right'}`}>
            <span class={`absolute top-1 grid h-6 w-6 place-items-center rounded-full bg-marble text-gold-deep ring-1 ring-gold left-0 ${i % 2 ? 'sm:-left-3' : 'sm:left-auto sm:-right-3'}`}>
              <FourPointStar size={12} />
            </span>
            <p class="eyebrow text-gold-deep">{t.when}</p>
            <h3 class="mt-2 text-3xl">{t.title}</h3>
            <p class="mt-2 text-ink/80">{t.text}</p>
          </li>
        ))}
      </ol>
      {season.cta && <div class="mt-16 text-center"><Cta {...season.cta} /></div>}
    </div>
  </section>

  <!-- The Seven -->
  <section class="bg-marble-deep px-4 py-24 text-center sm:px-8 sm:py-32">
    <div class="mx-auto max-w-3xl">
      <div class="mx-auto flex max-w-md items-end justify-center gap-[clamp(0.6rem,3vw,1.5rem)] text-gold" aria-hidden="true">
        {[0, 1, 2, 3, 2, 1, 0].map((lift, i) => (
          <span class="animate-glow" style={`transform:translateY(-${lift * 10}px);animation-delay:${i * 0.4}s`}>
            <FourPointStar size={i === 3 ? 30 : 20} />
          </span>
        ))}
      </div>
      <p class="eyebrow mt-12 text-gold-deep">{seven.eyebrow}</p>
      <h2 class="mt-4 text-[clamp(2.2rem,6vw,4rem)]">{seven.heading}</h2>
      <div class="prose-world mx-auto mt-8 text-lg [&_p]:mx-auto"><seven.Content /></div>
    </div>
  </section>

  <!-- The houses -->
  <section class="night relative isolate overflow-hidden py-24 sm:py-32">
    <Starfield count={50} seed={42} />
    <div class="px-4 text-center sm:px-8">
      <p class="eyebrow text-gold-light">{houses.eyebrow}</p>
      <h2 class="display mt-5 text-[clamp(2.2rem,7vw,4.5rem)] tracking-[0.1em]">{houses.heading}</h2>
      <div class="prose-world mx-auto mt-6 max-w-2xl text-lg text-starlight/80 [&_p]:mx-auto"><houses.Content /></div>
    </div>
    <ul class="mx-auto mt-14 flex max-w-6xl snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-6 sm:px-8 lg:grid lg:grid-cols-4 lg:overflow-visible">
      {houseList.map(({ data: h }) => (
        <li class="w-[68vw] max-w-[300px] shrink-0 snap-center lg:w-auto lg:max-w-none">
          <figure class="group">
            <Image src={banners[h.name]} widths={[300, 447]} sizes="(min-width: 1024px) 25vw, 68vw"
              alt={`${h.name}, House of the ${h.direction}: ${h.rule}. "${h.creed}" ${h.element}. ${h.motto}. ${h.bearing}.`}
              class="aspect-[447/1197] w-full rounded-sm shadow-2xl shadow-black/50 ring-1 ring-gold/20 transition duration-700 group-hover:-translate-y-2 group-hover:shadow-[0_20px_60px_rgb(198_161_91/0.25)]" />
            <figcaption class="mt-5 text-center">
              <span class="eyebrow block text-gold-light">{h.name}</span>
              <span class="mt-1 block font-display text-lg italic text-starlight/70">{h.motto}</span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
    {houses.cta && <div class="mt-12 text-center"><Cta {...houses.cta} variant="gold" /></div>}
  </section>
</Base>

<style>
  .noise-ring { animation: ring 6s ease-out infinite; opacity: 0; }
  @keyframes ring {
    0% { transform: scale(0.2); opacity: 0.7; }
    100% { transform: scale(1.4); opacity: 0; }
  }
</style>
