<script>
  // Deck settings: buyer view and the full secret, kept in the URL so a link carries its mode.
  const root_ = document.documentElement;
  const sync = () => {
    document.querySelectorAll<HTMLButtonElement>('[data-toggle]').forEach((b) => {
      const on = root_.classList.contains(b.dataset.toggle!);
      if (b.closest('[role=group]')) b.setAttribute('aria-pressed', String(on));
    });
    const q = new URLSearchParams(location.search);
    root_.classList.contains('buyer') ? q.set('view', 'buyer') : q.delete('view');
    q.set('secret', root_.classList.contains('secret') ? '1' : '0');
    history.replaceState(null, '', `${location.pathname}?${q}${location.hash}`);
  };
  document.querySelectorAll<HTMLButtonElement>('[data-toggle]').forEach((b) => b.addEventListener('click', () => { root_.classList.toggle(b.dataset.toggle!); sync(); }));
  sync();

  // A hidden star for the obsessive reader.
  const star = document.querySelector<HTMLButtonElement>('[data-star]');
  star?.addEventListener('click', () => { document.querySelector<HTMLElement>('[data-star-text]')!.hidden = false; star.setAttribute('aria-expanded', 'true'); });

  // The Seven: one line at a time, on click. Without JS, or in print, every line shows.
  const root = document.querySelector<HTMLElement>('[data-seven]');
  if (root) {
    const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')];
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    let shown = 1;
    const paint = () => {
      steps.forEach((s, i) => { s.style.opacity = i < shown ? '1' : '0'; s.setAttribute('aria-hidden', String(i >= shown)); });
      next.hidden = shown >= steps.length;
    };
    next.addEventListener('click', () => { shown += 1; paint(); });
    window.addEventListener('beforeprint', () => { shown = steps.length; paint(); document.querySelectorAll('details').forEach((d) => (d.open = true)); });
    paint();
  }
</script>
