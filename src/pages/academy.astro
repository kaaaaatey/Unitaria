---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
const page = (await getEntry('pages', 'academy'))!;
const { Content } = await render(page);
---
<Base title={page.data.title} description={page.data.description}>
  <PageHero eyebrow="Neuropa" title="The Academy" lede="The seat of the world, its favourite broadcast, and home for a year to every sixteen-year-old alive." />
  <section class="marble px-4 py-20 sm:px-8 sm:py-24">
    <article class="prose-world mx-auto max-w-3xl text-lg [&_h2]:mb-6 [&_h2]:mt-20 [&_h2]:text-[clamp(2rem,5vw,3rem)] [&_h2:first-of-type]:mt-0 [&_p]:mt-4">
      <Content />
    </article>
    <p class="mt-16 text-center"><a href="/houses" class="btn btn-gold">Meet the four houses</a></p>
  </section>
</Base>
