---
import CompassStar from './motifs/CompassStar.astro';
import StarRule from './motifs/StarRule.astro';
---
<footer class="night px-4 pb-12 pt-20 text-center sm:px-8">
  <CompassStar size={56} class="mx-auto text-gold" />
  <p class="eyebrow mt-6 text-gold-light">Unitaria</p>
  <p class="mx-auto mt-3 max-w-md font-display text-xl italic text-starlight/80">One world. Ten realms. Fifty years reconnected.</p>
  <StarRule class="mx-auto mt-10 max-w-xs" />
  <p class="mt-8 text-xs tracking-wider text-starlight/50">© 2026 Unitaria. An original world. All rights reserved.</p>
</footer>
