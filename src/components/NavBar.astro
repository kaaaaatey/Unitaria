---
// The main navigation: a floating pill of frosted glass. On phones the links sit in a
// three-by-three grid of glass (nothing scrolls sideways); from laptop width it floats
// over the page and stays at the top as you scroll.
import CompassStar from './motifs/CompassStar.astro';
import { nav } from '../data/nav';
const { class: extra = '' } = Astro.props as { class?: string };
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href + '/'));
---
<div class:list={["navbar relative z-50 bg-midnight px-3 py-3 lg:sticky lg:top-0 lg:h-0 lg:bg-transparent lg:p-0", extra]}>
  <nav aria-label="Main" class="nav-glass mx-auto flex items-center rounded-[1.6rem] p-1.5 text-starlight lg:absolute lg:left-1/2 lg:top-4 lg:w-max lg:-translate-x-1/2 lg:rounded-full">
    <a href="/" class="hidden shrink-0 items-center gap-2.5 rounded-full py-2 pl-4 pr-3 lg:flex" aria-label="Unitaria, home">
      <CompassStar size={20} class="text-gold" />
      <span class="eyebrow hidden text-[0.64rem] xl:inline">Unitaria</span>
    </a>
    <span class="mx-1 hidden h-5 w-px bg-white/15 lg:block" aria-hidden="true"></span>
    <ul class="grid w-full grid-cols-3 gap-1 text-center lg:flex lg:w-auto lg:gap-0.5">
      {nav.map((item) => (
        <li class="min-w-0">
          {item.live ? (
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}
              class="nav-link eyebrow flex min-h-11 items-center justify-center rounded-full px-2 text-[0.6rem] leading-tight tracking-[0.14em] text-starlight/80 hover:text-starlight aria-[current=page]:text-midnight lg:min-h-10 lg:whitespace-nowrap lg:px-3 lg:text-[0.6rem] lg:tracking-[0.18em] xl:px-3.5">
              {item.label}
            </a>
          ) : (
            <span class="eyebrow flex min-h-11 items-center justify-center px-2 text-[0.6rem] leading-tight tracking-[0.14em] text-starlight/40 lg:min-h-10">{item.label}</span>
          )}
        </li>
      ))}
    </ul>
  </nav>
</div>
<script>
  // Like Apple's bars, the glass changes tone with what's beneath it: pale over marble, dark over night.
  const navEl = document.querySelector<HTMLElement>('.nav-glass');
  const lum = (el: Element | null): number | null => {
    for (let n = el; n && n !== document.documentElement; n = n.parentElement) {
      if (n.closest('.navbar')) continue;
      const c = getComputedStyle(n).backgroundColor.match(/[\d.]+/g)?.map(Number);
      if (c && (c[3] ?? 1) > 0.5) return (0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2]) / 255;
    }
    return null;
  };
  let queued = false;
  const tone = () => {
    queued = false;
    if (!navEl) return;
    if (!matchMedia('(min-width: 64rem)').matches) {
      // Below laptop width the bar sits in its own band, so it simply matches that band.
      const c = getComputedStyle(navEl.parentElement!).backgroundColor.match(/[\d.]+/g)?.map(Number);
      const light = c && (0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2]) / 255 > 0.6;
      light ? navEl.setAttribute('data-tone', 'light') : navEl.removeAttribute('data-tone');
      return;
    }
    const r = navEl.getBoundingClientRect();
    const under = document.elementsFromPoint(r.left + 24, r.top + r.height / 2).find((e) => !e.closest('.navbar'));
    const l = lum(under ?? null);
    navEl.toggleAttribute('data-tone', false);
    if (l !== null && l > 0.6) navEl.setAttribute('data-tone', 'light');
  };
  const queue = () => { if (!queued) { queued = true; requestAnimationFrame(tone); } };
  addEventListener('scroll', queue, { passive: true });
  addEventListener('resize', queue);
  tone();
</script>

<style>
  .nav-glass {
    background: linear-gradient(180deg, rgb(255 255 255 / 0.09), rgb(255 255 255 / 0.03)), rgb(8 23 39 / 0.38);
    border: 1px solid rgb(255 255 255 / 0.12);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.14), 0 18px 50px -18px rgb(0 0 0 / 0.55);
    backdrop-filter: blur(16px) saturate(180%);
  }
  .nav-glass { transition: background-color 0.6s, color 0.6s, border-color 0.6s, box-shadow 0.6s; }
  .nav-glass[data-tone='light'] {
    background: linear-gradient(180deg, rgb(255 255 255 / 0.8), rgb(255 255 255 / 0.6));
    border-color: rgb(255 255 255 / 0.85);
    color: var(--color-ink);
    box-shadow: inset 0 1px 0 #fff, 0 18px 50px -20px rgb(26 29 43 / 0.35), 0 0 0 1px rgb(198 161 91 / 0.15);
  }
  .nav-glass[data-tone='light'] .nav-link:not([aria-current='page']) { color: rgb(26 29 43 / 0.78); }
  .nav-glass[data-tone='light'] .nav-link:not([aria-current='page']):hover { color: var(--color-ink); background: rgb(26 29 43 / 0.06); }
  .nav-glass[data-tone='light'] .eyebrow { color: inherit; }
  .nav-link { transition: color 0.4s, background-color 0.4s, box-shadow 0.4s; }
  .nav-link:hover { background: rgb(255 255 255 / 0.08); }
  .nav-link[aria-current='page'] {
    background: linear-gradient(180deg, #ecd7a4, var(--color-gold));
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.5), 0 4px 18px -4px rgb(198 161 91 / 0.7);
  }
</style>
