---
// The Academy's symbol: a gold, eight-pointed compass star.
// DRAFT logo for Katey's approval (GAPS.md: "The Academy logo, still to design").
interface Props { size?: number; class?: string; label?: string }
const { size = 48, class: cls = '', label } = Astro.props;
const long = [0, 90, 180, 270];
const short = [45, 135, 225, 315];
---
<svg
  viewBox="-50 -50 100 100" width={size} height={size} class={cls}
  role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}
>
  <circle r="31" fill="none" stroke="currentColor" stroke-width="0.6" opacity="0.7" />
  <circle r="35" fill="none" stroke="currentColor" stroke-width="0.35" opacity="0.5" />
  {short.map((a) => (
    <g transform={`rotate(${a})`}>
      <path d="M0 -30 L4 -4 L0 0Z" fill="currentColor" opacity="0.55" />
      <path d="M0 -30 L-4 -4 L0 0Z" fill="currentColor" opacity="0.3" />
    </g>
  ))}
  {long.map((a) => (
    <g transform={`rotate(${a})`}>
      <path d="M0 -48 L6 -6 L0 0Z" fill="currentColor" />
      <path d="M0 -48 L-6 -6 L0 0Z" fill="currentColor" opacity="0.6" />
    </g>
  ))}
  <circle r="2.2" fill="currentColor" />
</svg>
