---
// The great golden compass: slow-turning rings around the Academy star,
// with the four houses at the cardinal points.
import CompassStar from './CompassStar.astro';
interface Props { size?: string; class?: string; houses?: boolean }
const { size = 'min(78vw, 520px)', class: cls = '', houses = true } = Astro.props;
const ticks = Array.from({ length: 72 }, (_, i) => i * 5);
const points = [
  { name: 'POLARIS', a: 0 }, { name: 'AURORA', a: 90 },
  { name: 'LYRA', a: 180 }, { name: 'ORION', a: 270 },
];
---
<div class={`relative aspect-square text-gold ${cls}`} style={`width:${size}`} aria-hidden="true">
  <div class="absolute inset-[8%] rounded-full bg-gold/10 blur-3xl animate-glow"></div>
  <svg viewBox="-200 -200 400 400" class="absolute inset-0 h-full w-full animate-spin-slow">
    <circle r="196" fill="none" stroke="currentColor" stroke-width="0.6" opacity="0.6" />
    <circle r="186" fill="none" stroke="currentColor" stroke-width="0.4" opacity="0.4" />
    {ticks.map((a) => (
      <line x1="0" y1={a % 45 === 0 ? -196 : -192} x2="0" y2="-186" stroke="currentColor"
        stroke-width={a % 45 === 0 ? 1 : 0.4} transform={`rotate(${a})`} opacity="0.8" />
    ))}
    <circle r="150" fill="none" stroke="currentColor" stroke-width="0.4" stroke-dasharray="1 5" opacity="0.7" />
  </svg>
  <svg viewBox="-200 -200 400 400" class="absolute inset-0 h-full w-full animate-spin-slower">
    <ellipse rx="170" ry="62" fill="none" stroke="currentColor" stroke-width="0.4" opacity="0.45" />
    <ellipse rx="62" ry="170" fill="none" stroke="currentColor" stroke-width="0.4" opacity="0.45" />
    <circle cx="170" cy="0" r="2.4" fill="currentColor" />
    <circle cx="0" cy="-170" r="1.6" fill="currentColor" />
  </svg>
  {houses && (
    <svg viewBox="-200 -200 400 400" class="absolute inset-0 h-full w-full">
      {points.map((p) => (
        <text x={Math.sin((p.a * Math.PI) / 180) * 163} y={-Math.cos((p.a * Math.PI) / 180) * 163 + 4.5}
          text-anchor="middle" font-size="13" letter-spacing="4" fill="currentColor"
          style="font-family: var(--font-sans)">{p.name}</text>
      ))}
    </svg>
  )}
  <div class="absolute inset-[24%] grid place-items-center">
    <CompassStar size={999} class="h-full w-full drop-shadow-[0_0_24px_rgb(230_207_154/0.5)]" />
  </div>
</div>
