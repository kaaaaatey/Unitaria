---
import FourPointStar from './motifs/FourPointStar.astro';
interface Props { items: { when: string; title: string; text: string }[] }
const { items } = Astro.props;
---
<ol class="relative mx-auto max-w-3xl">
  <span class="absolute bottom-3 left-[11px] top-3 w-px bg-gradient-to-b from-gold/0 via-gold to-gold/0 sm:left-1/2" aria-hidden="true"></span>
  {items.map((t, i) => (
    <li class={`relative pb-12 pl-12 last:pb-0 sm:w-1/2 sm:pl-0 ${i % 2 ? 'sm:ml-auto sm:pl-12' : 'sm:pr-12 sm:text-right'}`}>
      <span class={`absolute left-0 top-1 grid h-6 w-6 place-items-center rounded-full bg-marble text-gold-deep ring-1 ring-gold ${i % 2 ? 'sm:-left-3' : 'sm:-right-3 sm:left-auto'}`}>
        <FourPointStar size={12} />
      </span>
      <p class="eyebrow text-gold-deep">{t.when}</p>
      <h3 class="mt-2 text-3xl">{t.title}</h3>
      <p class="mt-2 text-ink/80">{t.text}</p>
    </li>
  ))}
</ol>
