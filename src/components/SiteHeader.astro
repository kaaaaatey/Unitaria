---
import CompassStar from './motifs/CompassStar.astro';
import { nav } from '../data/nav';
const { light = false } = Astro.props as { light?: boolean };
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="fixed inset-x-0 top-0 z-50 text-starlight transition-colors duration-500" data-header data-tone={light ? 'light' : undefined}>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-8">
    <a href="/" class="flex items-center gap-3" aria-label="Unitaria, home">
      <CompassStar size={26} class="text-gold" />
      <span class="eyebrow text-[0.7rem]">Unitaria</span>
    </a>
    <details class="group" data-menu>
      <summary class="eyebrow flex min-h-11 cursor-pointer list-none items-center gap-3 px-2 [&::-webkit-details-marker]:hidden">
        <span class="group-open:hidden">Menu</span><span class="hidden group-open:inline">Close</span>
        <span class="flex w-5 flex-col gap-[5px]" aria-hidden="true">
          <span class="h-px w-full bg-current transition group-open:translate-y-[3px] group-open:rotate-45"></span>
          <span class="h-px w-full bg-current transition group-open:-translate-y-[3px] group-open:-rotate-45"></span>
        </span>
      </summary>
      <nav aria-label="Main" class="night fixed inset-x-0 top-16 bottom-0 overflow-y-auto px-6 py-10 sm:px-10">
        <ul class="mx-auto max-w-3xl divide-y divide-gold/20">
          {nav.map((item) => (
            <li>
              {item.live ? (
                <a href={item.href} aria-current={path === item.href ? 'page' : undefined}
                  class="flex items-baseline justify-between py-4 font-display text-3xl tracking-wide transition hover:text-gold-light aria-[current=page]:text-gold sm:text-4xl">
                  {item.label}
                </a>
              ) : (
                <span class="flex items-baseline justify-between gap-4 py-4 font-display text-3xl tracking-wide text-starlight/45 sm:text-4xl">
                  {item.label}<span class="eyebrow text-[0.6rem] text-gold/80">Opening soon</span>
                </span>
              )}
            </li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const menu = document.querySelector<HTMLDetailsElement>('[data-menu]');
  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 40);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && menu) menu.open = false; });
</script>

<style>
  header.scrolled { background: rgb(8 23 39 / 0.82); backdrop-filter: blur(12px); }
  header[data-tone='light']:not(.scrolled):not(:has(details[open])) { color: var(--color-ink); }
</style>
