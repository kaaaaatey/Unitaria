---
import { Image } from 'astro:assets';
import collage from '../../assets/crops/academy-collage.png';
---
<figure class="not-prose my-12 -mx-4 sm:mx-0">
  <Image src={collage} widths={[640, 1000, 1312]} sizes="(min-width: 768px) 768px, 100vw"
    alt="Concept art of the Academy: a white marble and gold palace with a glass dome above waterfalls and reflecting pools; a great hall with banners and a column of light; a round table beneath a star-map dome; a library of ladders and glowing globes; arches opening onto the sea."
    class="w-full rounded-2xl shadow-xl ring-1 ring-gold/30" />
  <figcaption class="mt-3 px-4 text-center text-sm text-ink/60 sm:px-0">The Academy, Neuropa.</figcaption>
</figure>
