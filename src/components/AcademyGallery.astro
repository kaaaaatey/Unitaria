---
// The Academy page's photo spread: the same renders used across the site (Home hero and gallery).
import { Image } from 'astro:assets';
import exterior from '../../assets/crops/academy-exterior.jpg';
import { academyGallery } from '../data/academyPhotos';
---
<div class="not-prose my-12 sm:-mx-16 lg:-mx-40">
  <figure class="group relative overflow-hidden rounded-[1.75rem] shadow-[0_40px_90px_-40px_rgb(26_29_43/0.55)]">
    <Image src={exterior} widths={[700, 1100, 1312]} sizes="(min-width: 1280px) 1088px, 100vw"
      alt="The Academy in Neuropa: a white marble and gold palace with a glass dome, slender towers, waterfalls and a long reflecting pool, above the lake at golden hour."
      class="aspect-[4/3] w-full object-cover object-[50%_40%] sm:aspect-[1312/500]" />
    <figcaption class="glass-light absolute bottom-3 left-3 !rounded-2xl px-4 py-3 sm:bottom-5 sm:left-5">
      <span class="block font-display text-lg leading-tight text-ink sm:text-2xl">The Academy, Neuropa</span>
      <span class="mt-0.5 hidden text-sm text-ink/70 sm:block">Clifftops, marble and the glass-and-gold dome.</span>
    </figcaption>
  </figure>
  <ul class="mt-3 grid grid-cols-2 gap-3 sm:mt-5 sm:gap-5 lg:grid-cols-6">
    {academyGallery.map((g) => (
      <li class={g.span}>
        <figure class="group relative h-full overflow-hidden rounded-[1.5rem] shadow-[0_30px_70px_-40px_rgb(26_29_43/0.5)]">
          <Image src={g.img} widths={[480, 800]} sizes={g.sizes} alt={g.alt}
            class="h-full min-h-48 w-full object-cover transition duration-[1.6s] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.06]" />
          <figcaption class="glass-light absolute inset-x-3 bottom-3 !rounded-2xl px-4 py-3 sm:inset-x-4 sm:bottom-4">
            <span class="block font-display text-lg leading-tight text-ink sm:text-2xl">{g.title}</span>
            <span class="mt-0.5 hidden text-sm text-ink/70 sm:block">{g.text}</span>
          </figcaption>
        </figure>
      </li>
    ))}
  </ul>
</div>
