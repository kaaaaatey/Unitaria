---
// The house the compass points to: shared by the quiz reveal and the result pages.
import { Image } from 'astro:assets';
import { banners } from '../../data/banners';
interface Props { house: any; headingLevel?: 'h1' | 'h2' }
const { house: h, headingLevel: H = 'h1' } = Astro.props;
---
<article class="text-center lg:text-left">
  <p class="eyebrow text-gold-light">The compass points {h.direction.toLowerCase()}</p>
  <H data-result-heading tabindex="-1" class="display mt-4 text-[clamp(3rem,11vw,5.5rem)] leading-none tracking-[0.16em] outline-none">{h.name}</H>
  <p class="eyebrow mt-6 text-gold-light">{h.rule} · {h.nickname}</p>
  <p class="mt-3 font-display text-[clamp(1.5rem,4vw,2.1rem)] italic">“{h.creed}”</p>
  <p class="mt-4 text-starlight/80"><span class="font-display text-xl italic">{h.motto}</span>, “{h.mottoTranslation}”</p>
  <div class="mt-8 flex items-center justify-center gap-6 lg:justify-start">
    <Image src={banners[h.name as keyof typeof banners]} widths={[120, 240]} sizes="112px" alt="" class="w-24 shrink-0 rounded-lg shadow-xl shadow-black/40 ring-1 ring-gold/20 sm:w-28" />
    <div class="max-w-xs text-left"><p class="eyebrow text-[0.6rem] text-gold-light">At their best</p><p class="mt-2 text-starlight/80">{h.best}</p></div>
  </div>
  <div class="mt-10 flex flex-wrap justify-center gap-3 lg:justify-start"><slot /></div>
</article>
